---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const baseUrl = base.endsWith('/') ? base : `${base}/`;
const asset = (path) => `${base.replace(/\/$/, '')}/${path.replace(/^\/+/, '')}`;
const repoUrl = 'https://github.com/ImAno177/PaperReader';

const screens = {
  library: {
    href: `${baseUrl}docs/screens/#library-screen`,
    light: {
      src: 'showcase/library-light.png',
      alt: 'PaperReader Library screen showing saved papers in light theme',
    },
    dark: {
      src: 'showcase/library-dark.png',
      alt: 'PaperReader Library screen showing saved papers and reading filters in dark theme',
    },
  },
  search: {
    href: `${baseUrl}docs/screens/#search-screen`,
    light: {
      src: 'showcase/search-light.png',
      alt: 'PaperReader Search screen showing recent paper searches in light theme',
    },
    dark: {
      src: 'showcase/search-dark.png',
      alt: 'PaperReader Search screen showing recent paper searches in dark theme',
    },
  },
  detail: {
    href: `${baseUrl}docs/screens/#paper-detail-screen`,
    light: {
      src: 'showcase/arxiv-detail-light.png',
      alt: 'PaperReader light paper detail screen for Attention Is All You Need from arXiv',
    },
    dark: {
      src: 'showcase/arxiv-detail-dark.png',
      alt: 'PaperReader dark paper detail screen for Attention Is All You Need from arXiv',
    },
  },
  reader: {
    href: `${baseUrl}docs/screens/#mobile-reader-screen`,
    light: {
      src: 'showcase/attention-mobile-light.png',
      alt: 'PaperReader mobile reader showing Attention Is All You Need in light theme',
    },
    dark: {
      src: 'showcase/attention-mobile-dark.png',
      alt: 'PaperReader mobile reader showing Attention Is All You Need in dark theme',
    },
  },
  sources: {
    href: `${baseUrl}docs/screens/#more-branches`,
    light: {
      src: 'showcase/sources-error-light.png',
      alt: 'PaperReader Sources screen showing blocked and orphaned provider states in light theme',
    },
    dark: {
      src: 'showcase/sources-error-dark.png',
      alt: 'PaperReader Sources screen showing blocked and orphaned provider states in dark theme',
    },
  },
};

const path = [
  ['01', 'Find it', 'Search enabled sources by title, phrase, DOI, arXiv ID, PMID, or PMCID.'],
  ['02', 'Check and keep it', 'Review the record, version, provenance, and available files before saving.'],
  ['03', 'Read it again', 'Open supported mobile HTML or the original PDF, including offline when its verified artifact is retained.'],
];

const docs = [
  ['Start here', 'Set up the project and understand its current scope.', `${baseUrl}docs/getting-started/`],
  ['Follow a workflow', 'Find, save, import, read offline, or inspect sources.', `${baseUrl}docs/workflows/`],
  ['Know each screen', 'Read the controls, states, and expected outcomes.', `${baseUrl}docs/screens/`],
];
---

<BaseLayout title="PaperReader | Read the paper you meant to keep" description="An open-source Android paper library and mobile reader for finding, preserving, and reading research papers.">
  <a class="skip-link" href="#content">Skip to content</a>

  <nav class="site-nav" aria-label="Primary navigation">
    <a class="brand" href={baseUrl}>
      <span class="brand-mark" aria-hidden="true">PR</span>
      <span>PaperReader</span>
    </a>
    <div class="nav-links">
      <a class="nav-journey" href={`${baseUrl}#journey`}>How it works</a>
      <a href={`${baseUrl}docs/`}>Docs</a>
      <ThemeToggle />
      <a class="nav-github" href={repoUrl} target="_blank" rel="noreferrer" aria-label="Open PaperReader on GitHub">
        <span class="nav-github-label">GitHub</span>
        <svg viewBox="-1 -1 18 18" aria-hidden="true" fill="currentColor" focusable="false">
          <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.49c-2.23.48-2.7-1.08-2.7-1.08-.36-.93-.89-1.18-.89-1.18-.73-.5.06-.49.06-.49.8.06 1.22.82 1.22.82.72 1.22 1.89.87 2.35.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.96 0-.88.31-1.6.82-2.16-.08-.2-.36-1.02.08-2.13 0 0 .67-.22 2.2.82A7.66 7.66 0 0 1 8 4.49a7.7 7.7 0 0 1 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.28.82 2.16 0 3.08-1.87 3.75-3.65 3.95.29.25.54.73.54 1.47l-.01 2.18c0 .21.14.46.55.38A8 8 0 0 0 8 0Z" />
        </svg>
      </a>
    </div>
  </nav>

  <main id="content">
    <section id="top" class="site-shell hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Android paper library and mobile reader</p>
        <h1 id="hero-title">
          Keep the paper<br />
          you meant to <span class="hero-highlight">read.</span>
        </h1>
        <p class="hero-intro">
          Search enabled sources, preserve the exact record and its provenance, then read supported mobile HTML or the original PDF when available.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={`${baseUrl}#journey`}>
            See search to reading
            <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M3 8h9M8 3l5 5-5 5" />
            </svg>
          </a>
          <a class="button button-secondary" href={`${baseUrl}docs/workflows/`}>Follow a workflow</a>
        </div>
      </div>

      <div class="hero-media">
        <a class="screen-link hero-screen-link" href={screens.reader.href} aria-label="Open mobile reader screen documentation">
          <figure class="screen-frame hero-shot hero-shot-main">
            <img
              data-theme-image
              data-light-src={asset(screens.reader.light.src)}
              data-dark-src={asset(screens.reader.dark.src)}
              data-light-alt={screens.reader.light.alt}
              data-dark-alt={screens.reader.dark.alt}
              src={asset(screens.reader.light.src)}
              alt={screens.reader.light.alt}
              width="1080"
              height="2400"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        </a>
      </div>
    </section>

    <section class="site-shell path-strip" aria-label="The PaperReader workflow">
      {path.map(([number, title, detail]) => (
        <article class="path-step" data-reveal>
          <p class="path-number">{number}</p>
          <div>
            <h2>{title}</h2>
            <p>{detail}</p>
          </div>
        </article>
      ))}
    </section>

    <section id="journey" class="site-shell story" aria-labelledby="journey-title">
      <header class="story-heading" data-reveal>
        <p class="section-kicker">One paper / three decisions</p>
        <h2 id="journey-title">From a query to a paper you can return to.</h2>
      </header>

      <article class="proof-chapter proof-chapter-pair">
        <div class="proof-copy" data-reveal>
          <p class="proof-index">01 / Find</p>
          <h3>Search without losing your trail.</h3>
          <p>Recent queries stay close to discovery. Save a result and it moves into a local library with its reading state, not into an anonymous bookmark list.</p>
          <a class="text-link" href={`${baseUrl}docs/workflows/#find-and-save-a-paper`}>Find and save a paper <span aria-hidden="true">-&gt;</span></a>
        </div>
        <div class="proof-media proof-media-pair">
          {[screens.search, screens.library].map((screen) => (
            <a class="screen-link proof-screen" data-reveal href={screen.href} aria-label={`Open ${screen.light.alt} documentation`}>
              <div class="showcase-image-wrap">
                <img
                  data-scale-image
                  data-theme-image
                  data-light-src={asset(screen.light.src)}
                  data-dark-src={asset(screen.dark.src)}
                  data-light-alt={screen.light.alt}
                  data-dark-alt={screen.dark.alt}
                  src={asset(screen.light.src)}
                  alt={screen.light.alt}
                  loading="lazy"
                  width="1080"
                  height="2400"
                  decoding="async"
                />
              </div>
            </a>
          ))}
        </div>
      </article>

      <article class="proof-chapter proof-chapter-reverse">
        <div class="proof-copy" data-reveal>
          <p class="proof-index">02 / Check</p>
          <h3>Keep the version you chose.</h3>
          <p>Paper Detail keeps identifiers, provider, version, access, license, and available files visible before you choose how to read.</p>
          <a class="text-link" href={`${baseUrl}docs/concepts/#identity-and-merging`}>Understand paper identity <span aria-hidden="true">-&gt;</span></a>
        </div>
        <div class="proof-media proof-media-single">
          <a class="screen-link proof-screen" data-reveal href={screens.detail.href} aria-label="Open Paper Detail screen documentation">
            <div class="showcase-image-wrap">
              <img
                data-scale-image
                data-theme-image
                data-light-src={asset(screens.detail.light.src)}
                data-dark-src={asset(screens.detail.dark.src)}
                data-light-alt={screens.detail.light.alt}
                data-dark-alt={screens.detail.dark.alt}
                src={asset(screens.detail.light.src)}
                alt={screens.detail.light.alt}
                loading="lazy"
                width="1080"
                height="2400"
                decoding="async"
              />
            </div>
          </a>
        </div>
      </article>

      <article class="proof-chapter">
        <div class="proof-copy" data-reveal>
          <p class="proof-index">03 / Read</p>
          <h3>Read the structure, not just the page.</h3>
          <p>Supported HTML papers add contents, in-document search, citation return, adjustable text, figures, tables, and exact-document annotations. The original PDF remains the fidelity fallback when available.</p>
          <a class="text-link" href={`${baseUrl}docs/reading/`}>Explore the reader <span aria-hidden="true">-&gt;</span></a>
        </div>
        <div class="proof-media proof-media-single proof-media-reader">
          <a class="screen-link proof-screen" data-reveal href={screens.reader.href} aria-label="Open mobile reader screen documentation">
            <div class="showcase-image-wrap">
              <img
                data-scale-image
                data-theme-image
                data-light-src={asset(screens.reader.light.src)}
                data-dark-src={asset(screens.reader.dark.src)}
                data-light-alt={screens.reader.light.alt}
                data-dark-alt={screens.reader.dark.alt}
                src={asset(screens.reader.light.src)}
                alt={screens.reader.light.alt}
                loading="lazy"
                width="1080"
                height="2400"
                decoding="async"
              />
            </div>
          </a>
        </div>
      </article>

      <article class="honest-state" data-reveal>
        <div class="honest-copy">
          <p class="proof-index">Honest states</p>
          <h3>When a source cannot run, the app says why.</h3>
          <p>Blocked, unavailable, and orphaned provider states stay visible so recovery is a decision, not a mystery.</p>
          <a class="text-link" href={`${baseUrl}docs/sources-and-extensions/`}>Inspect source behavior <span aria-hidden="true">-&gt;</span></a>
        </div>
        <a class="screen-link honest-screen" href={screens.sources.href} aria-label="Open Sources screen documentation">
          <div class="showcase-image-wrap">
            <img
              data-theme-image
              data-light-src={asset(screens.sources.light.src)}
              data-dark-src={asset(screens.sources.dark.src)}
              data-light-alt={screens.sources.light.alt}
              data-dark-alt={screens.sources.dark.alt}
              src={asset(screens.sources.light.src)}
              alt={screens.sources.light.alt}
              loading="lazy"
              width="1080"
              height="2400"
              decoding="async"
            />
          </div>
        </a>
      </article>

      <article class="proof-chapter proof-chapter-reverse">
        <div class="proof-copy" data-reveal>
          <p class="proof-index">04 / Verify</p>
          <h3>See the states that make the product trustworthy.</h3>
          <p>These are fresh captures from the local Android emulator: the grouped More hub, the
            persistent Download queue, and the readable CGP-Tuning paper after its HTML/assets
            split.</p>
          <a class="text-link" href="${baseUrl}docs/screens/#local-emulator-audit">View the emulator audit <span aria-hidden="true">-&gt;</span></a>
        </div>
        <div class="proof-media proof-media-pair">
          <a class="screen-link proof-screen" data-reveal href="${baseUrl}docs/screens/#local-emulator-audit" aria-label="Open the local emulator More capture documentation">
            <div class="showcase-image-wrap">
              <img
                src={asset('showcase/emulator-more.png')}
                alt="PaperReader More hub captured from the local Android emulator"
                loading="lazy"
                width="1080"
                height="2400"
                decoding="async"
              />
            </div>
          </a>
          <a class="screen-link proof-screen" data-reveal href="${baseUrl}docs/screens/#local-emulator-audit" aria-label="Open the local emulator Download queue capture documentation">
            <div class="showcase-image-wrap">
              <img
                src={asset('showcase/emulator-download-queue.png')}
                alt="PaperReader Download queue captured from the local Android emulator"
                loading="lazy"
                width="1080"
                height="2400"
                decoding="async"
              />
            </div>
          </a>
        </div>
      </article>
    </section>

    <section class="dark-section" aria-labelledby="docs-title">
      <div class="site-shell docs-cta">
        <div class="docs-heading">
          <p class="section-kicker">Start with the task you have</p>
          <h2 id="docs-title">The docs follow the same path.</h2>
          <p>Set up PaperReader, follow a complete workflow, or inspect the controls and states of every screen.</p>
        </div>
        <div class="docs-links" aria-label="Documentation entry points">
          {docs.map(([title, detail, href]) => (
            <a href={href}>
              <span>{title}</span>
              <small>{detail}</small>
              <span aria-hidden="true">-&gt;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-shell footer-inner">
      <p>PaperReader / open-source Android paper reader</p>
      <a href={repoUrl} target="_blank" rel="noreferrer">View the repository <span aria-hidden="true">-&gt;</span></a>
    </div>
  </footer>
</BaseLayout>
