---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const baseUrl = base.endsWith('/') ? base : `${base}/`;
const asset = (path) => `${base.replace(/\/$/, '')}/${path.replace(/^\/+/, '')}`;
const repoUrl = 'https://github.com/ImAno177/PaperReader';

const screens = [
  {
    title: 'Library',
    label: 'Saved papers · dark theme',
    src: 'showcase/library-dark.png',
    alt: 'PaperReader Library screen showing saved papers and reading filters in dark theme',
    detail: 'Saved papers, reading filters, and local progress.',
  },
  {
    title: 'Library',
    label: 'Saved papers · light theme',
    src: 'showcase/library-light.png',
    alt: 'PaperReader Library screen showing saved papers in light theme',
    detail: 'The same library in a light reading surface.',
  },
  {
    title: 'Search',
    label: 'Recent searches · dark theme',
    src: 'showcase/search-dark.png',
    alt: 'PaperReader Search screen showing recent paper searches in dark theme',
    detail: 'Recent searches remain available beside discovery.',
  },
  {
    title: 'Paper detail',
    label: 'arXiv · Attention Is All You Need',
    src: 'showcase/arxiv-detail-dark.png',
    alt: 'PaperReader detail screen for Attention Is All You Need from arXiv',
    detail: 'Metadata, abstract, versions, and reading actions.',
  },
  {
    title: 'Mobile reader',
    label: 'Attention Is All You Need · 0% read',
    src: 'showcase/attention-mobile-dark.png',
    alt: 'PaperReader mobile reader showing the beginning of Attention Is All You Need',
    detail: 'Cached arXiv HTML with the paper title and abstract.',
  },
  {
    title: 'Sources',
    label: 'Unavailable provider states · dark theme',
    src: 'showcase/sources-error-dark.png',
    alt: 'PaperReader Sources screen showing unavailable provider states in dark theme',
    detail: 'Provider failures stay visible and can be retried.',
  },
];

const facts = [
  ['Local library', 'Keep papers, history, and backups on the device.'],
  ['Exact versions', 'Carry provenance from the result to the reading artifact.'],
  ['Honest states', 'Show offline, unavailable, and loading states with recovery actions.'],
];
---

<BaseLayout title="PaperReader · Read closer" description="An open-source Android reader for finding, saving, and reading scholarly papers locally.">
  <a class="skip-link" href="#content">Skip to content</a>

  <nav class="site-nav" aria-label="Primary navigation">
    <a class="brand" href={baseUrl}>
      <span class="brand-mark" aria-hidden="true">PR</span>
      <span>PaperReader</span>
    </a>
    <div class="nav-links">
      <a href={`${baseUrl}#screens`}>Screens</a>
      <a href={`${baseUrl}docs/`}>Docs</a>
      <a class="nav-github" href={repoUrl} target="_blank" rel="noreferrer" aria-label="Open PaperReader on GitHub">
        GitHub
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
          <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.49c-2.23.48-2.7-1.08-2.7-1.08-.36-.93-.89-1.18-.89-1.18-.73-.5.06-.49.06-.49.8.06 1.22.82 1.22.82.72 1.22 1.89.87 2.35.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.96 0-.88.31-1.6.82-2.16-.08-.2-.36-1.02.08-2.13 0 0 .67-.22 2.2.82A7.66 7.66 0 0 1 8 4.49a7.7 7.7 0 0 1 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.28.82 2.16 0 3.08-1.87 3.75-3.65 3.95.29.25.54.73.54 1.47l-.01 2.18c0 .21.14.46.55.38A8 8 0 0 0 8 0Z" />
        </svg>
      </a>
    </div>
  </nav>

  <main id="content">
    <section id="top" class="site-shell hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Open-source Android reader</p>
        <h1 id="hero-title">Keep the paper <span class="hero-highlight">close.</span></h1>
        <p class="hero-intro">
          PaperReader helps you find, save, and read scholarly papers without losing the source,
          version, or local copy that made the paper useful.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={`${baseUrl}#screens`}>
            View the screens
            <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M3 8h9M8 3l5 5-5 5" />
            </svg>
          </a>
          <a class="button button-secondary" href={`${baseUrl}docs/`}>Read the docs</a>
        </div>
        <p class="hero-note">Discovery · provenance · reading · backup</p>
      </div>

      <div class="hero-media" aria-label="PaperReader screen preview" data-reveal>
        <figure class="screen-frame hero-shot hero-shot-main">
          <img
            src={asset('showcase/library-dark.png')}
            alt="PaperReader Library screen showing saved papers and reading filters in dark theme"
            width="1080"
            height="1920"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>Library / dark theme</figcaption>
        </figure>
        <figure class="screen-frame hero-shot hero-shot-secondary">
          <img
            src={asset('showcase/arxiv-detail-dark.png')}
            alt="PaperReader detail screen for Attention Is All You Need from arXiv"
            width="1080"
            height="1920"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Paper detail / arXiv</figcaption>
        </figure>
      </div>
    </section>

    <section class="site-shell fact-strip" aria-label="Product facts">
      {facts.map(([title, detail]) => (
        <article class="fact-card" data-reveal>
          <p class="section-kicker">{title}</p>
          <p>{detail}</p>
        </article>
      ))}
    </section>

    <section id="screens" class="site-shell section" aria-labelledby="screens-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Product evidence</p>
          <h2 id="screens-title">The app in use.</h2>
        </div>
        <p>
          Current PaperReader screens, labelled by destination and visible state. The selection keeps
          the landing page short while the complete review ledger lives in the repository.
        </p>
      </div>

      <div class="screen-grid">
        {screens.map((screen, index) => (
          <figure class={`showcase-card ${index === 3 ? 'showcase-card-feature' : ''}`} data-reveal>
            <div class="showcase-image-wrap">
              <img
                data-scale-image
                src={asset(screen.src)}
                alt={screen.alt}
                loading="lazy"
                width="1080"
                height="1920"
                decoding="async"
              />
            </div>
            <figcaption>
              <div>
                <strong>{screen.title}</strong>
                <span>{screen.detail}</span>
              </div>
              <small>{screen.label}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="dark-section" aria-labelledby="docs-title">
      <div class="site-shell docs-cta">
        <div>
          <p class="section-kicker">Documentation</p>
          <h2 id="docs-title">Know what the screen promises.</h2>
          <p>
            Read the product notes, screenshot labels, architecture boundaries, and local development
            path in the docs.
          </p>
        </div>
        <a class="button button-primary" href={`${baseUrl}docs/`}>
          Open docs
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M3 8h9M8 3l5 5-5 5" />
          </svg>
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-shell footer-inner">
      <p>PaperReader · open-source Android reading</p>
      <a href={repoUrl} target="_blank" rel="noreferrer">View the repository <span aria-hidden="true">↗</span></a>
    </div>
  </footer>
</BaseLayout>
