---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const baseUrl = base.endsWith('/') ? base : `${base}/`;
const asset = (path) => `${base.replace(/\/$/, '')}/${path.replace(/^\/+/, '')}`;
const repoUrl = 'https://github.com/ImAno177/PaperReader';

const screens = [
  {
    title: 'Library',
    href: `${baseUrl}docs/screens/#library-screen`,
    light: {
      src: 'showcase/library-light.png',
      alt: 'PaperReader Library screen showing saved papers in light theme',
    },
    dark: {
      src: 'showcase/library-dark.png',
      alt: 'PaperReader Library screen showing saved papers and reading filters in dark theme',
    },
  },
  {
    title: 'Search',
    href: `${baseUrl}docs/screens/#search-screen`,
    light: {
      src: 'showcase/search-light.png',
      alt: 'PaperReader Search screen showing recent paper searches in light theme',
    },
    dark: {
      src: 'showcase/search-dark.png',
      alt: 'PaperReader Search screen showing recent paper searches in dark theme',
    },
  },
  {
    title: 'Paper detail',
    href: `${baseUrl}docs/screens/#paper-detail-screen`,
    light: {
      src: 'showcase/arxiv-detail-light.png',
      alt: 'PaperReader light paper detail screen for Attention Is All You Need from arXiv',
    },
    dark: {
      src: 'showcase/arxiv-detail-dark.png',
      alt: 'PaperReader dark paper detail screen for Attention Is All You Need from arXiv',
    },
  },
  {
    title: 'Mobile reader',
    href: `${baseUrl}docs/screens/#mobile-reader-screen`,
    light: {
      src: 'showcase/attention-mobile-light.png',
      alt: 'PaperReader mobile reader showing Attention Is All You Need in light theme',
    },
    dark: {
      src: 'showcase/attention-mobile-dark.png',
      alt: 'PaperReader mobile reader showing Attention Is All You Need in dark theme',
    },
  },
  {
    title: 'Sources',
    href: `${baseUrl}docs/screens/#more-branches`,
    light: {
      src: 'showcase/sources-error-light.png',
      alt: 'PaperReader Sources screen showing blocked and orphaned provider states in light theme',
    },
    dark: {
      src: 'showcase/sources-error-dark.png',
      alt: 'PaperReader Sources screen showing blocked and orphaned provider states in dark theme',
    },
  },
];

const facts = [
  ['Find papers', 'Search installed research sources.'],
  ['Save exact versions', 'Keep the source, version, and local file together.'],
  ['Read offline', 'Open saved HTML or the original PDF.'],
];
---

<BaseLayout title="PaperReader | Read closer" description="An open-source Android paper reader for finding, saving, and reading offline.">
  <a class="skip-link" href="#content">Skip to content</a>

  <nav class="site-nav" aria-label="Primary navigation">
    <a class="brand" href={baseUrl}>
      <span class="brand-mark" aria-hidden="true">PR</span>
      <span>PaperReader</span>
    </a>
    <div class="nav-links">
      <a href={`${baseUrl}#screens`}>Screens</a>
      <a href={`${baseUrl}docs/`}>Docs</a>
      <ThemeToggle />
      <a class="nav-github" href={repoUrl} target="_blank" rel="noreferrer" aria-label="Open PaperReader on GitHub">
        <span class="nav-github-label">GitHub</span>
        <svg viewBox="-1 -1 18 18" aria-hidden="true" fill="currentColor" focusable="false">
          <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.49c-2.23.48-2.7-1.08-2.7-1.08-.36-.93-.89-1.18-.89-1.18-.73-.5.06-.49.06-.49.8.06 1.22.82 1.22.82.72 1.22 1.89.87 2.35.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.96 0-.88.31-1.6.82-2.16-.08-.2-.36-1.02.08-2.13 0 0 .67-.22 2.2.82A7.66 7.66 0 0 1 8 4.49a7.7 7.7 0 0 1 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.28.82 2.16 0 3.08-1.87 3.75-3.65 3.95.29.25.54.73.54 1.47l-.01 2.18c0 .21.14.46.55.38A8 8 0 0 0 8 0Z" />
        </svg>
      </a>
    </div>
  </nav>

  <main id="content">
    <section id="top" class="site-shell hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Open-source Android reader</p>
        <h1 id="hero-title">
          Keep papers<br />
          <span class="hero-highlight">close.</span>
        </h1>
        <p class="hero-intro">
          Find papers. Keep their source and version. Read them offline.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={`${baseUrl}#screens`}>
            See the app
            <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M3 8h9M8 3l5 5-5 5" />
            </svg>
          </a>
          <a class="button button-secondary" href={`${baseUrl}docs/`}>Read docs</a>
        </div>
      </div>

      <div class="hero-media">
        <a class="screen-link hero-screen-link" href={screens[0].href} aria-label="Open Library screen documentation">
          <figure class="screen-frame hero-shot hero-shot-main">
            <img
              data-theme-image
              data-light-src={asset(screens[0].light.src)}
              data-dark-src={asset(screens[0].dark.src)}
              data-light-alt={screens[0].light.alt}
              data-dark-alt={screens[0].dark.alt}
              src={asset(screens[0].light.src)}
              alt={screens[0].light.alt}
              width="1080"
              height="2400"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        </a>
      </div>
    </section>

    <section class="site-shell fact-strip" aria-label="Product facts">
      {facts.map(([title, detail]) => (
        <article class="fact-card" data-reveal>
          <p class="section-kicker">{title}</p>
          <p>{detail}</p>
        </article>
      ))}
    </section>

    <section id="screens" class="site-shell section" aria-labelledby="screens-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Screens</p>
          <h2 id="screens-title">The app in use.</h2>
        </div>
        <p>Five real PaperReader screens, paired for Light and Dark.</p>
      </div>

      <div class="screen-grid">
        {screens.map((screen) => (
          <a
            class="showcase-card screen-link"
            data-reveal
            href={screen.href}
            aria-label={`Open ${screen.title} screen documentation`}
          >
            <div class="showcase-image-wrap">
              <img
                data-scale-image
                data-theme-image
                data-light-src={asset(screen.light.src)}
                data-dark-src={asset(screen.dark.src)}
                data-light-alt={screen.light.alt}
                data-dark-alt={screen.dark.alt}
                src={asset(screen.light.src)}
                alt={screen.light.alt}
                loading="lazy"
                width="1080"
                height="2400"
                decoding="async"
              />
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="dark-section" aria-labelledby="docs-title">
      <div class="site-shell docs-cta">
        <div>
          <p class="section-kicker">Documentation</p>
          <h2 id="docs-title">Go deeper in the docs.</h2>
          <p>Features, workflows, architecture, extensions, and local setup.</p>
        </div>
        <a class="button button-primary" href={`${baseUrl}docs/`}>
          Read docs
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M3 8h9M8 3l5 5-5 5" />
          </svg>
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-shell footer-inner">
      <p>PaperReader / open-source Android paper reader</p>
      <a href={repoUrl} target="_blank" rel="noreferrer">View the repository <span aria-hidden="true">-&gt;</span></a>
    </div>
  </footer>
</BaseLayout>
