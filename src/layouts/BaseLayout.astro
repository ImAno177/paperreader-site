---
import '../styles/global.css';

const {
  title = 'PaperReader | Read closer',
  description = 'A local-first scientific reading tool for discovering, collecting, and reading papers on Android.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const baseUrl = base.endsWith('/') ? base : `${base}/`;
const canonicalUrl = new URL(baseUrl, Astro.site ?? 'https://imano177.github.io/');
const previewImageUrl = new URL('showcase/library-dark.png', canonicalUrl);
const previewImagePath = `${baseUrl}showcase/library-light.png`;
const faviconPath = `${baseUrl}favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2efe7" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PaperReader" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:image" content={previewImageUrl.toString()} />
    <meta property="og:image:alt" content="PaperReader Library screen showing saved papers in dark theme" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl.toString()} />
    <link rel="icon" href={faviconPath} type="image/svg+xml" />
    <link rel="preload" as="image" href={previewImagePath} type="image/png" fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('paperreader-theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.dataset.theme = theme;
          }
        } catch {
          // Keep the default light theme when storage is unavailable.
        }
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { initFieldNotesMotion } from '../scripts/field-notes-motion.js';

      initFieldNotesMotion();
    </script>
  </body>
</html>
